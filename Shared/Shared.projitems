<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>BBBCC387-0BE5-4401-B262-6DCBC776DD5D</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>VoxelMaterialLimit</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)PatchedIncludeStream.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShaderLimitPatch.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShaderOverlay.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShaderRewrites.cs" />
  </ItemGroup>
</Project>
